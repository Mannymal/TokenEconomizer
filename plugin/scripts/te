#!/bin/sh
# TokenEconomizer command line (`te status`, `te toolprune show`, `te config`, ...).
dir=$(CDPATH= cd -- "${0%/*}" && pwd)
for py in "${TE_PYTHON:-}" python3 python; do
  [ -n "$py" ] || continue
  # Windows' Store alias (`.../WindowsApps/python3`) is on PATH even with no Python installed,
  # and only prints where to get one.
  case $(command -v "$py" 2>/dev/null) in ''|*/WindowsApps/*) continue ;; esac
  exec "$py" "$dir/te_bootstrap.py" cli "$@"
done
echo "te: no python3 on PATH (set TE_PYTHON)" >&2
exit 1
